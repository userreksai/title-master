[Unit]
Description=SEO Title Master
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=title-master
Group=title-master
WorkingDirectory=/usr/local/title_master
ExecStartPre=/usr/local/title_master/title-master -config /usr/local/title_master/master.json -check-config
ExecStart=/usr/local/title_master/title-master -config /usr/local/title_master/master.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/usr/local/title_master/data
UMask=0077

[Install]
WantedBy=multi-user.target
